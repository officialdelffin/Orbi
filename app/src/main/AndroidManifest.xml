<?xml version="1.0" encoding="utf-8"?>


<!-- Configurando o manifesto para iniciar diretamente na tela de testes do Onboarding : -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />


    <!-- Aplicando o tema global do Orbi para corrigir as cores do aplicativo : -->
    <application


        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbi"
        tools:targetApi="31">


        <!-- Definindo a OnboardingActivity como a tela principal de inicio (Launcher) : -->
        <activity


            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="true">


            <intent-filter>


                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />


            </intent-filter>


        </activity>


        <activity


            android:name=".MainActivity"
            android:exported="false" />


    </application>


</manifest>