<?xml version="1.0" encoding="utf-8"?>
<!-- Configurando o tema base da aplicacao com Material Components : -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Aplicando as cores ao tema sem ActionBar para um visual moderno : -->
    <style name="Theme.Orbi" parent="Theme.MaterialComponents.Light.NoActionBar">

        <item name="colorPrimary">@color/orbi_dark_brown</item>
        <item name="colorPrimaryVariant">@color/orbi_olive</item>
        <item name="colorOnPrimary">@color/orbi_white</item>
        <item name="colorSecondary">@color/orbi_olive</item>
        <item name="colorSecondaryVariant">@color/orbi_light_olive</item>
        <item name="colorOnSecondary">@color/orbi_white</item>

        <!-- Pintando a barra de status (topo) com a cor creme e os icones de escuro : -->
        <item name="android:statusBarColor">@color/orbi_cream</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Pintando a barra de navegacao (rodape) com a cor creme e os icones de escuro : -->
        <item name="android:navigationBarColor">@color/orbi_cream</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

    </style>

</resources>