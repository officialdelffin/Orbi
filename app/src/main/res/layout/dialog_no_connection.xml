<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_dialog"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="30dp">


    <ImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/ic_sad_cloud_cream_color" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_connection_title"
        android:textColor="@color/orbi_cream"
        android:textSize="30sp"
        android:textStyle="bold" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/no_connection_description"
        android:textColor="@color/orbi_cream"
        android:textSize="20sp" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_retry_connection"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="24dp"
        android:text="@string/no_connection_btn"
        android:textAllCaps="false"
        android:textColor="@color/orbi_cream"
        app:backgroundTint="@color/orbi_olive"
        app:cornerRadius="30dp" />


</LinearLayout>