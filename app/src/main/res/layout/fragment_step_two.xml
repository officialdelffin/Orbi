<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbi_cream">

    <TextView
        android:id="@+id/tv_step_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        android:text="Quais dias você vai focar?"
        android:textColor="@color/orbi_dark_brown"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_step_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        android:text="Selecione os dias da semana em que este ciclo estará ativo na sua rotina."
        android:textColor="@color/orbi_dark_brown"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_step_title" />

    <!-- Container dos 7 dias da semana -->
    <LinearLayout
        android:id="@+id/layout_days_of_week"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:weightSum="7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_step_desc">

        <!-- Domingo (1) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="D"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

        <!-- Segunda (2) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="S"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

        <!-- Terça (3) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_3"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="T"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

        <!-- Quarta (4) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_4"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="Q"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

        <!-- Quinta (5) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_5"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="Q"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

        <!-- Sexta (6) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_6"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="S"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

        <!-- Sábado (7) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_day_7"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:text="S"
            android:textSize="16sp"
            app:cornerRadius="50dp"
            app:strokeColor="@color/orbi_olive" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>