<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbi_cream">

    <!-- Cabeçalho: Botão Voltar e Legenda -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back"
        android:layout_width="60dp"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@color/orbi_olive"
        app:cornerRadius="30dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="@color/orbi_cream"
        app:layout_constraintBottom_toBottomOf="@+id/tv_legend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_legend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="30dp"
        android:text="As cores dos pontos indicam o estado do ciclo: branco para pendente, marrom para foco e verde para descanso."
        android:textColor="@color/orbi_dark_brown"
        android:justificationMode="inter_word"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_back"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Card Principal Central -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_timer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="30dp"
        app:cardBackgroundColor="@color/orbi_cream"
        app:cardCornerRadius="40dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back"
        app:strokeColor="#DDBA9A"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="488dp"
            android:padding="30dp">

            <!-- Círculo de Progresso e Status -->
            <FrameLayout
                android:id="@+id/frame_progress"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_timer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:progress="75"
                    app:indicatorColor="@color/orbi_olive"
                    app:indicatorSize="120dp"
                    app:trackColor="#DDBA9A"
                    app:trackCornerRadius="10dp"
                    app:trackThickness="6dp" />

                <TextView
                    android:id="@+id/tv_progress_status"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="Intervalo"
                    android:textColor="@color/orbi_dark_brown"
                    android:textSize="16sp" />
            </FrameLayout>

            <!-- Textos de Tempo -->
            <TextView
                android:id="@+id/tv_timer_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:text="Período de\nintervalo"
                android:textColor="@color/orbi_dark_brown"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/tv_time_left"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/frame_progress"
                app:layout_constraintTop_toTopOf="@+id/frame_progress"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tv_time_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:text="25:00"
                android:textColor="@color/orbi_dark_brown"
                android:textSize="35sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/frame_progress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/frame_progress"
                app:layout_constraintTop_toBottomOf="@+id/tv_timer_label" />

            <!-- Pílula de Bolinhas (Períodos) -->
            <TextView
                android:id="@+id/tv_dots_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Periodos de foco :"
                android:textColor="@color/orbi_dark_brown"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/frame_progress" />

            <LinearLayout
                android:id="@+id/layout_dots_container"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_pill_beige"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tv_dots_label"
                tools:layout_editor_absoluteX="30dp" />

            <!-- Texto de Status Atual -->
            <TextView
                android:id="@+id/tv_current_status_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Você está no intervalo do periodo 3 com 12 periodos de foco"
                android:textColor="@color/orbi_dark_brown"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_dots_container" />

            <!-- Controles de Mídia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_pill_olive"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/tv_current_status_desc"
                tools:layout_editor_absoluteX="30dp">

                <ImageButton
                    android:id="@+id/btn_play"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/ic_play"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/btn_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/ic_pause"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/btn_skip"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/ic_skip_next"
                    android:scaleType="fitCenter" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botão Inferior de Reiniciar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_restart_cycle"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_pill_beige"
        android:gravity="center_vertical|start"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text="Reiniciar ciclo"
        android:textAllCaps="false"
        android:textColor="@color/orbi_dark_brown"
        android:textSize="18sp"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_refresh"
        app:iconGravity="end"
        app:iconSize="28dp"
        app:iconTint="@color/orbi_dark_brown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>